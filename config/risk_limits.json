{
  "version": "1.0.0",
  "description": "Risk management limits for trading system",

  "position_limits": {
    "max_position_base": 10.0,
    "max_position_quote": 100000.0,
    "max_position_pct_portfolio": 0.5,
    "max_inventory_skew": 0.8,
    "warning_threshold_pct": 0.7
  },

  "loss_limits": {
    "max_loss_per_trade": 1000.0,
    "max_loss_per_day": 5000.0,
    "max_loss_per_week": 15000.0,
    "max_loss_per_month": 50000.0,
    "max_drawdown_pct": 0.2,
    "stop_trading_on_daily_loss": true
  },

  "order_limits": {
    "min_order_size_base": 0.001,
    "max_order_size_base": 1.0,
    "max_order_size_quote": 50000.0,
    "max_order_value_pct_book": 0.1,
    "max_orders_per_second": 10,
    "max_orders_per_minute": 100,
    "max_cancel_rate_per_minute": 500
  },

  "market_conditions": {
    "max_spread_bps": 200.0,
    "min_book_depth_quote": 10000.0,
    "max_price_move_per_second_pct": 0.02,
    "halt_on_exchange_issues": true,
    "halt_on_connectivity_loss_seconds": 30.0
  },

  "leverage_limits": {
    "max_leverage": 1.0,
    "use_margin": false,
    "margin_call_threshold": 0.0
  },

  "operational": {
    "max_consecutive_losses": 10,
    "max_slippage_bps": 50.0,
    "require_price_sanity_check": true,
    "price_sanity_deviation_pct": 0.05,
    "emergency_shutdown_conditions": [
      "max_daily_loss_exceeded",
      "max_position_exceeded",
      "exchange_connectivity_lost",
      "invalid_market_data"
    ]
  },

  "circuit_breakers": {
    "enable_circuit_breakers": true,
    "cooldown_period_seconds": 300,
    "auto_resume_after_cooldown": false,
    "require_manual_override": true
  }
}
